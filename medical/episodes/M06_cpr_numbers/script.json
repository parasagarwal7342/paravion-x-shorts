 "lines": [
  {
   "beat": "HOOK",
   "text": "Good CPR comes down to two numbers.",
   "ost": "CPR in|two numbers.",
   "visual": {
    "type": "ecg",
    "pattern": "vfib",
    "label": "CARDIAC ARREST",
    "big": "Start CPR",
    "color": "red"
   },
   "keys": [
    "two"
   ]
  },
  {
   "beat": "HOOK",
   "text": "Do you know them?",
   "ost": "Do you|know them?",
   "visual": {
    "type": "question"
   },
   "keys": [
    "know"
   ]
  },
  {
   "beat": "SUB",
   "text": "Sixty seconds. Exam-ready.",
   "ost": "60 seconds.|Exam-ready.",
   "visual": {
    "type": "timer"
   },
   "keys": [
    "Exam-ready."
   ]
  },
  {
   "beat": "CONTEXT",
   "text": "When an adult collapses and isn't breathing normally, call for help and an AED.",
   "ost": "Call for help|and an AED.",
   "visual": {
    "type": "tags",
    "tags": [
     "Call for help",
     "Get an AED"
    ]
   },
   "keys": [
    "help"
   ],
   "source": "AHA, Resus Council UK"
  },
  {
   "beat": "CONTEXT",
   "text": "Then push hard and fast in the centre of the chest.",
   "ost": "Hard and fast.|Centre of chest.",
   "visual": {
    "type": "hero",
    "note": "Hands on the lower breastbone"
   },
   "keys": [
    "hard",
    "fast"
   ],
   "source": "AHA, Resus Council UK"
  },
  {
   "beat": "CONTEXT",
   "text": "Stay for fact three. It's the exam favourite.",
   "ost": "Wait for|fact 3.",
   "visual": {
    "type": "teaser",
    "n": 3
   },
   "keys": [
    "three."
   ]
  },
  {
   "beat": "FACT1",
   "text": "Fact one. Rate: one hundred to one hundred twenty compressions a minute.",
   "ost": "Rate:|100 to 120.",
   "visual": {
    "type": "stat",
    "text": "100-120",
    "count": false,
    "label": "COMPRESSIONS PER MINUTE",
    "sub": "Adults"
   },
   "keys": [
    "one.",
    "twenty"
   ],
   "source": "AHA, Resus Council UK"
  },
  {
   "beat": "FACT2",
   "text": "Fact two. Depth: about five to six centimetres in adults.",
   "ost": "Depth:|5 to 6 cm.",
   "visual": {
    "type": "stat",
    "text": "5-6 cm",
    "count": false,
    "label": "COMPRESSION DEPTH",
    "sub": "Adults"
   },
   "keys": [
    "two.",
    "six"
   ],
   "source": "AHA, Resus Council UK"
  },
  {
   "beat": "FACT3",
   "text": "And the exam favourite. Let the chest fully recoil, and keep pauses short.",
   "ost": "Full recoil.|Short pauses.",
   "visual": {
    "type": "tags",
    "tags": [
     "Full recoil",
     "Minimal pauses"
    ]
   },
   "keys": [
    "favourite.",
    "recoil,"
   ],
   "source": "AHA, Resus Council UK"
  },
  {
   "beat": "RECAP",
   "text": "Hard, fast, full recoil. One twenty, five to six. Don't stop.",
   "ost": "Hard. Fast.|Don't stop.",
